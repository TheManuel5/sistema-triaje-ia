# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=triaje_db
DB_USER=triaje_user
DB_PASSWORD=triaje_pass_2024_CAMBIAR_EN_PRODUCCION

# ========================================
# OPENAI API CONFIGURATION
# ========================================
# Obtener API Key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-api-key-aqui
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# ========================================
# N8N CONFIGURATION
# ========================================
N8N_ENCRYPTION_KEY=clave-de-encriptacion-segura-cambiar
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123_CAMBIAR
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# ========================================
# EMAIL CONFIGURATION (para notificaciones)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail
EMAIL_FROM=noreply@triaje-ia.com
EMAIL_TO_ALERTS=equipo.medico@hospital.com

# ========================================
# TELEGRAM CONFIGURATION (opcional)
# ========================================
TELEGRAM_BOT_TOKEN=tu_bot_token_de_telegram
TELEGRAM_CHAT_ID=tu_chat_id

# ========================================
# HCE SIMULATOR CONFIGURATION
# ========================================
HCE_API_URL=http://localhost:8000
HCE_API_KEY=hce-api-key-simulator-2024

# ========================================
# STREAMLIT CONFIGURATION
# ========================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME_BASE=light
STREAMLIT_THEME_PRIMARY_COLOR=#1E88E5

# ========================================
# SECURITY & SESSION
# ========================================
SECRET_KEY=clave-secreta-para-sesiones-cambiar-en-produccion
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/triaje/app.log

# ========================================
# BACKUP CONFIGURATION
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Diariamente a las 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# ========================================
# PERFORMANCE
# ========================================
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=300

# ========================================
# FEATURES FLAGS
# ========================================
ENABLE_AI_TRIAJE=true
ENABLE_HCE_INTEGRATION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_TELEGRAM_NOTIFICATIONS=false
ENABLE_PDF_REPORTS=true
ENABLE_AUDIT_LOG=true
